{
  "expo": {
    "name": "Cognitive Canvas",
    "slug": "cognitive-canvas",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cognitivecanvas.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.cognitivecanvas.app"
    },
    "plugins": [
      "expo-dev-client",
      "./plugins/withJetpackInk"
    ],
    "extra": {
      "eas": {
        "projectId": "b34a25ab-f5ce-4b29-8f94-0f84e466441d"
      }
    },
    "owner": "angel-expos-team"
  }
}
