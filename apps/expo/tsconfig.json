{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@cognitive-canvas/core": [
        "../../packages/core/src/index.ts"
      ],
      "@cognitive-canvas/core/*": [
        "../../packages/core/src/*"
      ]
    }
  },
  "include": [
    "App.tsx",
    "index.js",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios"
  ]
}
